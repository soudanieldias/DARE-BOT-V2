{
  "name": "dare-bot",
  "version": "5.0.0",
  "private": true,
  "description": "DARE-bot v5 - Bot Discord + Painel Admin",
  "scripts": {
    "dev": "concurrently -n bot,web -c blue,green \"pnpm --filter @dare-bot/bot dev\" \"pnpm --filter @dare-bot/web dev\"",
    "dev:bot": "pnpm --filter @dare-bot/bot dev",
    "dev:web": "pnpm --filter @dare-bot/web dev",
    "build": "pnpm -r build",
    "build:bot": "pnpm --filter @dare-bot/bot build",
    "build:web": "pnpm --filter @dare-bot/web build",
    "db:migrate": "pnpm --filter @dare-bot/database db:migrate",
    "db:migrate:generate": "pnpm --filter @dare-bot/database db:migrate:generate",
    "db:migrate:revert": "pnpm --filter @dare-bot/database db:migrate:revert",
    "db:schema:sync": "pnpm --filter @dare-bot/database db:schema:sync",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@10.28.2"
}
