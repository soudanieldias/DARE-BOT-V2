{
  "name": "dare-bot",
  "version": "4.0.0",
  "description": "DARE-bot v4 - Bot de gerenciamento de comunidade no Discord",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:migrate": "npm run typeorm -- migration:run -d src/infra/database/data-source.ts",
    "db:migrate:generate": "npm run typeorm -- migration:generate -d src/infra/database/data-source.ts",
    "db:migrate:revert": "npm run typeorm -- migration:revert -d src/infra/database/data-source.ts",
    "db:schema:sync": "npm run typeorm -- schema:sync -d src/infra/database/data-source.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.0.18"
  }
}
